datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum AuctionType {
  ENGLISH
  DUTCH
}

enum AuctionStatus {
  ACTIVE
  ENDED
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  piUserId      String         @unique
  username      String
  walletAddress String?
  createdAt     DateTime       @default(now())
  nfts          Nft[]          @relation("OwnerNfts")
  bids          Bid[]
  transactions  Transaction[]
}

model Nft {
  id          String    @id @default(uuid())
  tokenId     String    @unique
  metadataUri String
  rarity      Rarity
  isBox       Boolean   @default(false)
  isOpened    Boolean   @default(false)
  ownerId     String
  creatorId   String
  royaltyFee  Float     @default(0.05) // 5% default
  owner       User      @relation("OwnerNfts", fields: [ownerId], references: [id])
  auctions    Auction[]
}

model Auction {
  id           String        @id @default(uuid())
  nftId        String
  type         AuctionType   @default(ENGLISH)
  startPrice   Float
  reservePrice Float?
  buyNowPrice  Float?
  currentPrice Float
  startTime    DateTime
  endTime      DateTime
  status       AuctionStatus @default(ACTIVE)
  nft          Nft           @relation(fields: [nftId], references: [id])
  bids         Bid[]
}

model Bid {
  id        String   @id @default(uuid())
  auctionId String
  bidderId  String
  amount    Float
  createdAt DateTime @default(now())
  auction   Auction  @relation(fields: [auctionId], references: [id])
  bidder    User     @relation(fields: [bidderId], references: [id])
}

model Transaction {
  id              String   @id @default(uuid())
  piPaymentId     String   @unique
  txHash          String?
  userId          String
  amount          Float
  platformFee     Float
  royaltyFeePaid  Float
  sellerAmount    Float
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}
